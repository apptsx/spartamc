# Configurações do Servidor SpartaMC
# Copie este arquivo para .env e preencha com seus valores

# Porta do servidor (padrão: 3000)
PORT=3000

# Senha secreta para JWT (gere uma senha forte)
JWT_SECRET=sua_senha_secreta_aqui_mude_isto123

# URL do seu frontend (para CORS)
FRONTEND_URL=http://localhost:5500

# ============ Discord OAuth2 ============
# Obtenha em: https://discord.com/developers/applications
DISCORD_CLIENT_ID=SEU_CLIENT_ID
DISCORD_CLIENT_SECRET=seu_client_secret_aqui
DISCORD_REDIRECT_URI=http://localhost:3000/settings
DISCORD_REDIRECT_URI_PROD=https://seu-site.com/settings
DISCORD_REDIRECT_URI_PROD_LOGIN=https://seu-site.com/index.html
DISCORD_GUILD_ID=SEU_GUILD_ID

# Token do bot (https://discord.com/developers/applications → Bot)
DISCORD_TOKEN=SEU_BOT_TOKEN

# Cargo de admin no Discord (use ID ou nome)
# ADMIN_ROLE_ID=ID_DO_CARGO_AQUI
ADMIN_ROLE_NAME=Administrador

# Segredo interno bot→servidor
BOT_SECRET=seu_bot_secret
API_URL=http://localhost:3000

# ============ Mercado Pago ============
# Obtenha em: https://www.mercadopago.com.br/developers
MP_CLIENT_ID=SEU_CLIENT_ID
MP_CLIENT_SECRET=seu_client_secret_aqui
MP_NOTIFICATION_URL=

# ============ MySQL (local) ============
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sparta
DB_USER=root
DB_PASS=