# Token do Bot Discord (https://discord.com/developers/applications → Bot)
DISCORD_TOKEN=seu_token_aqui

# MySQL Database
DB_HOST=seu_host
DB_PORT=3306
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_NAME=sparta

# PostgreSQL Database
PG_HOST=seu_host_pg
PG_PORT=5432
PG_USER=seu_usuario_pg
PG_PASSWORD=sua_senha_pg
PG_DATABASE=postgres

# Mercado Pago
MP_CLIENT_ID=seu_client_id
MP_CLIENT_SECRET=seu_client_secret

# SSH Deploy (use SSH keys ou SSH_PASSWORD com sshpass)
SSH_HOST=seu-servidor.com
SSH_USER=root
SSH_DEST=/home/
# SSH_PASSWORD=sua_senha_ssh